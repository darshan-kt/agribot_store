# Copy to .env and fill in real values: `make env` does this and generates strong secrets.
# .env is gitignored. Never commit real credentials.
#
# The *_PORT values below are host ports only; services reach each other by container
# name on the compose network and are unaffected. If a host service already owns one
# (a local Postgres on 5432, Redis on 6379, Mosquitto on 1883 are common), change it
# here rather than stopping the host service.

# ---- Postgres (PostGIS + TimescaleDB) ----
POSTGRES_USER=agri
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agri
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Object storage (S3 API, detection and sample images) ----
# SeaweedFS S3 gateway. The brief specified MinIO, which withdrew its community
# container images; SeaweedFS speaks the same S3 API so nothing in the app changes.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=agri-images
S3_PORT=9000
S3_ADMIN_PORT=9333

# ---- MQTT broker ----
# One credential per client. Robots authenticate as their own robot_id and are
# confined to their own topic subtree by infra/mosquitto/acl.
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_API_PASSWORD=change-me
MQTT_ROBOT_PASSWORD=change-me

# ---- API ----
API_PORT=8000
JWT_SECRET=change-me
LOG_LEVEL=INFO

# ---- Web ----
WEB_PORT=3000
# Where the UI reads data from.
#   fixtures  JSON exported from the seeded database by `make fixtures` (default,
#             while the backend services are being built)
#   http      the live REST API described by packages/contracts/openapi.yaml
NEXT_PUBLIC_DATA_SOURCE=fixtures
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
